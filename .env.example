# Optional settings. Everything works without this file.
# Which AI to use by default: claude (your Pro plan) or ollama (free, local)
# RESUME_AGENT_BACKEND=claude
# Claude model: sonnet (default, uses less of your Pro limits) or opus (strongest)
# CLAUDE_MODEL=sonnet
# Local model for Ollama (download first with: ollama pull <name>)
# OLLAMA_MODEL=qwen3:8b
# Gmail sending for email applications (see README, "Send email applications")
# GMAIL_USER=you@gmail.com
# GMAIL_APP_PASSWORD=abcd efgh ijkl mnop
